# Neon Postgres — branch "dev" para desenvolvimento local, "main" para produção
# https://neon.tech (criar projeto -> Connection Details -> pooled connection string)
DATABASE_URL="postgresql://user:password@ep-xxxx.neon.tech/autoguide?sslmode=require"

# Auth.js (NextAuth v5) — gerar com `npx auth secret`
AUTH_SECRET=""

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:3000/api/auth/callback/google (dev)
#               https://<seu-dominio>/api/auth/callback/google (prod)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Neon Object Storage (S3-compatible, beta) — https://neon.com/docs/storage/overview
NEON_STORAGE_ENDPOINT=""
NEON_STORAGE_REGION="auto"
NEON_STORAGE_BUCKET=""
NEON_STORAGE_ACCESS_KEY_ID=""
NEON_STORAGE_SECRET_ACCESS_KEY=""

# Groq — provedor de IA (ver seção 6 do PRD: uso restrito a normalização de
# texto/assistência de conteúdo, nunca como fonte de verdade sobre specs)
# https://console.groq.com/keys
GROQ_API_KEY=""
